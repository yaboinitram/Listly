# Where the Listly API runs
VITE_API_BASE_URL=http://localhost:3000

# Base URL for public share links (the web/ share page). The share_id is appended.
VITE_SHARE_BASE_URL=http://localhost:5174/s/

# true = wishlists/items are stored locally in the extension (no server routes needed).
# Flip to false once /wishlists routes exist on the server. Sign in always uses the real API.
VITE_MOCK_WISHLISTS=true
